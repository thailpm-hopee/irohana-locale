# Defaults for ci-watch.mjs (all optional — CLI flags override these).
# Precedence: process.env > .claude/skills/tobirato-feature-delivery/.env >
#             .claude/skills/.env > .claude/.env

# Default repo, so --repo can be omitted: owner/name
CI_WATCH_REPO=LogioOne/tobirato

# gh CLI to call (a PAT-carrying wrapper). Use `gh` if it has repo access.
CI_WATCH_GH=gh-tok
